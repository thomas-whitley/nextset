{
  "expo": {
    "name": "Momentum",
    "slug": "momentum-gym-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momentum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3f8fe1fb-ae22-4576-91c4-b77444330a79"
      }
    },
    "packagerOpts": {
      "config": "metro.config.js"
    },
    "owner": "twhitley",
    "android": {
      "package": "com.twhitley.momentumgymtracker"
    }
  }
}
